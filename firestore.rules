rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Config (Auctions toggle) - TEMPORARY PUBLIC WRITE FOR DEMO
    match /config/global {
      allow read, write: if true; 
    }

    // Catalog
    match /catalog/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inventory
    match /inventory/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.sellerId);
    }

    // Auctions
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.sellerId);

      // Price History Subcollection
      match /priceHistory/{historyId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // Inventory Price History
    match /inventory/{listingId} {
      match /priceHistory/{historyId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // Sales and Orders
    match /sales/{saleId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.buyerId || isAdmin());
      allow create: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn();
    }
  }
}
